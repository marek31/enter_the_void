<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<unique-id>1-enter-void-terminal</unique-id>
	<command>foot --working-directory=%f</command>
	<description>Open a terminal in this folder</description>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>folder-cloud</icon>
	<name>Send to pCloud (copy link)</name>
	<unique-id>2-enter-void-pcloud-send</unique-id>
	<command>cloud send %F</command>
	<description>Upload to pCloud/Send and copy a share link to the clipboard</description>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
</actions>
