#!/bin/sh
# niri session for runit systems (niri-session needs systemd). Started by the greeter (greetd).
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=niri XDG_SESSION_DESKTOP=niri
# niri's log goes to a daily file, not the console: at shutdown the seat is revoked before niri
# exits, and its "page flip ... permission denied" warnings would otherwise fill the screen.
logdir=${XDG_STATE_HOME:-$HOME/.local/state}/niri
mkdir -p "$logdir"
find "$logdir" -name '*-niri.log' -mtime +14 -delete 2>/dev/null
exec dbus-run-session niri --session >>"$logdir/$(date +%F)-niri.log" 2>&1
