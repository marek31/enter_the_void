#!/bin/sh
# Plasma autostart: take Noctalia's palette (its kcolorscheme template, written while niri runs) when it
# changed since the last Plasma login, so both sessions share one colour scheme.
f=$HOME/.local/share/color-schemes/noctalia.colors
stamp=${XDG_STATE_HOME:-$HOME/.local/state}/enter_void/plasma-colors.stamp
[ -f "$f" ] || exit 0
[ -f "$stamp" ] && [ ! "$f" -nt "$stamp" ] && exit 0
# plasma-apply-colorscheme skips a scheme that is already set, even if its file changed
plasma-apply-colorscheme BreezeDark >/dev/null 2>&1
plasma-apply-colorscheme noctalia && mkdir -p "${stamp%/*}" && touch "$stamp"
