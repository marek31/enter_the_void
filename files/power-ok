#!/bin/sh
# power-ok [MIN_PERCENT]: exit 0 when background work (updates) is fine right now:
# on mains power, or a battery above MIN_PERCENT (default 50). No battery at all (desktop, VM) counts as mains.
min=${1:-50}
set -- /sys/class/power_supply/BAT*
[ -e "$1" ] || exit 0
for p in /sys/class/power_supply/*; do
    [ "$(cat "$p/type" 2>/dev/null)" = Mains ] && [ "$(cat "$p/online" 2>/dev/null)" = 1 ] && exit 0
done
for b in /sys/class/power_supply/BAT*; do
    [ "$(cat "$b/capacity" 2>/dev/null || echo 0)" -gt "$min" ] && exit 0
done
exit 1
