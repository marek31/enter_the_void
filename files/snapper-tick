#!/bin/sh
# Run by cron every 15 min: timeline snapshot of every snapper config, then prune by the
# TIMELINE_LIMIT_* / NUMBER_LIMIT values. Once an hour also refresh the grub snapshot menu.
. /etc/conf.d/snapper
for c in $SNAPPER_CONFIGS; do
    snapper --no-dbus -c "$c" create -c timeline -d "timeline" || logger -t snapper-tick "create $c failed"
    snapper --no-dbus -c "$c" cleanup timeline || logger -t snapper-tick "timeline cleanup $c failed"
    snapper --no-dbus -c "$c" cleanup number || logger -t snapper-tick "number cleanup $c failed"
done
if [ "$(date +%M)" -lt 15 ]; then
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || logger -t snapper-tick "grub-mkconfig failed"
fi
